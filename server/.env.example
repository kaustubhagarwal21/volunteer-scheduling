# Copy to server/.env for local development (server/.env is git-ignored).
# Matches the Postgres container in docker-compose.yml.
DATABASE_URL=postgres://volunteer:volunteer@localhost:5433/volunteer_dev

# IANA zone the organisation operates in. Shift dates/times are wall-clock times in this zone.
ORG_TIMEZONE=Asia/Kolkata

PORT=3000

# Production: set NODE_ENV=production and point DATABASE_URL at the managed database, e.g.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full
